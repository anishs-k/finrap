NODE_ENV=production
HOST=127.0.0.1
PORT=4100

MONGO_URI=mongodb://127.0.0.1:27017/data_masters

APP_URL=https://yourdomain.com
CLIENT_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
TRUST_PROXY=true
SERVE_FRONTEND=true
FRONTEND_DIST_PATH=../frontend/dist
REQUEST_BODY_LIMIT=5mb
SESSION_IDLE_MINUTES=30

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=no-reply@yourdomain.com
MAIL_PASS=replace-with-mail-password
MAIL_FROM="Finrep <no-reply@yourdomain.com>"

RAZORPAY_KEY_ID=replace-with-live-or-test-key-id
RAZORPAY_KEY_SECRET=replace-with-live-or-test-key-secret
RAZORPAY_CURRENCY=INR

KYC_PROVIDER_BASE_URL=https://apifinrep.avmanagement.in/api/verification
KYC_PROVIDER_AUTH_URL=https://apifinrep.avmanagement.in/api/auth/login/
KYC_PROVIDER_EMAIL=provider-login@example.com
KYC_PROVIDER_PASSWORD=replace-with-provider-password
KYC_PROVIDER_TOKEN=optional-static-provider-access-token
CIBIL_PROVIDER_BASE_URL=https://console.verifyal.com/vendor-api
CIBIL_PROVIDER_AUTH_URL=
CIBIL_PROVIDER_API_KEY=replace-with-verifyal-cibil-api-key
CIBIL_PROVIDER_TOKEN=replace-with-verifyal-cibil-token
CIBIL_PROVIDER_EMAIL=
CIBIL_PROVIDER_PASSWORD=

SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=replace-with-strong-password
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_WHATSAPP_NUMBER=919999999999

